# Copy to .env for local development. Compose supplies its own values for the
# containerised services; this file is for the host-run web dev server and for
# anything you run outside Compose.

# --- web (apps/web) ---
# Server-side only. Never prefix with NEXT_PUBLIC_, or it lands in the bundle.
API_INTERNAL_URL=http://localhost:8000
# The only public variable: used for absolute Open Graph and canonical URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- api (services/api) ---
APP_ENV=local
LOG_LEVEL=info
# Host port is 5433 (see docker-compose.yml); inside the network it is 5432.
DATABASE_URL=postgresql+psycopg://registry:registry@localhost:5433/registry
SMTP_HOST=localhost
SMTP_PORT=1025

# Only needed if the browser talks to the API directly, which it does not:
# guest writes go through the web app's route handlers.
CORS_ORIGINS=

# Never commit real values for anything below. Security is deliberately
# deferred in the POC (D23); the magic link is a stub, not an identity design.
SESSION_SECRET=dev-only-not-a-secret
